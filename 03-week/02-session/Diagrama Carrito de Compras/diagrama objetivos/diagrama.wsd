@@startuml cosa
    class CompraRapida {
        <<goal>>
    }
    class ReducirAbandonoCarrito {
        <<goal>>
    }
    class AumentarConversion {
        <<goal>>
    }
    class MejorarConfiabilidad {
        <<goal>>
